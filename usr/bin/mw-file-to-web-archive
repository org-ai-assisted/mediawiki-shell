#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../share/mediawiki-shell/common
## Overridable for tests (dist-ai convention); unset -> production path, byte-identical.
source "${MEDIAWIKI_SHELL_COMMON:-/usr/share/mediawiki-shell/common}"

archive_check() {
  stecho "Checking if already archived by asking web archive... https://web.archive.org/web/$1"

  curl_http_status_code="$(${curl} "${curl_web_archive_opts[@]}" "https://web.archive.org/web/$1")" || true
  curl_output="$(stcat "${TMPFOLDER}/webarchive/curl-output-temp")"

  ## Check for a web archive memento 'location:' header FIRST, before the status: curl
  ## --head --location replays the CAPTURED page, so the FINAL status is that page's own
  ## code (200, 403, 404, 500, ...), NOT an "archived?" signal -- a replayed 403/404 is a
  ## 302 to a memento then the captured code, whereas a genuine exclusion/miss is a DIRECT
  ## 403/404 with no memento. --location prints EVERY hop's headers and the canonical memento
  ## redirect can be a LATER hop (an earlier hop may be a relative or normalization redirect),
  ## so scan all hops. Match the header name case-insensitively (RFC 9110) and anchor the value
  ## to the web.archive.org memento host so a mid-value substring or a look-alike host is not
  ## accepted.
  location_line="$(grep -i -m1 -E -- '^location:[[:space:]]+https://web\.archive\.org/web/' <<<"${curl_output}" || true)"
  if [ -n "${location_line}" ]; then
    ## Extract from the matched 'location:' line only, so a memento URL appearing in a Link: or
    ## other header is not recorded in its place.
    link="$(grep -i -o -E -- 'https://web\.archive\.org/web/[^[:space:][:cntrl:]]+' <<<"${location_line}" | head -n1 || true)"
    printf '%s\n' "Already archived according to the web archive. curl_http_status_code: '${curl_http_status_code}'"
    printf '%s\n' "$1" "${link}" | tee -a -- "${TMPFOLDER}/webarchive/already-archived.txt"
    return 0
  fi

  ## No memento: the status is the web archive's own control response.
  if [ "${curl_http_status_code}" = "403" ]; then
    printf '%s\n' "Excluded from web archive."
    stecho "$1" | tee -a -- "${TMPFOLDER}/webarchive/already-known-excluded.txt"
    return 0
  fi

  ## No memento (typically 404 from /web/<url>) means the web archive holds no snapshot,
  ## i.e. not yet archived -- return non-zero so the caller proceeds to archive_save. (A
  ## truly down ORIGIN is detected by archive_save via HTTP 523, not here.)
  printf '%s\n' "Not yet archived. curl_http_status_code: ${curl_http_status_code} | curl_output:"
  printf '%s\n' "${curl_output}"
  return 1
}

archive_save() {
  printf '%s\n' "Requesting web archive link... https://web.archive.org/save/$1"

  curl_http_status_code="$(curl_run "${curl_web_archive_opts[@]}" "https://web.archive.org/save/$1")" || true
  curl_output="$(stcat "${TMPFOLDER}/webarchive/curl-output-temp")"

  ## Success detection mirrors archive_check. Check for a web archive memento 'location:'
  ## header FIRST, before the status codes: curl --head --location replays the CAPTURED page,
  ## so the FINAL status is that page's own code (200, 403, 404, 500, ...), NOT save success.
  ## The terminal codes below are the SAVE endpoint's own control responses, which carry no
  ## memento, so a successful save of a page that replays e.g. 403 is still recorded as
  ## archived here rather than misclassified as excluded. --location prints EVERY hop's headers
  ## and the canonical memento redirect can be a LATER hop (an earlier hop may be a relative or
  ## normalization redirect), so scan all hops. Match the header name case-insensitively
  ## (RFC 9110) and anchor the value to the web.archive.org memento host so a mid-value
  ## substring or a look-alike host is not recorded as archived.
  location_line="$(grep -i -m1 -E -- '^location:[[:space:]]+https://web\.archive\.org/web/' <<<"${curl_output}" || true)"
  if [ -n "${location_line}" ]; then
    ## Extract from the matched 'location:' line only, so a memento URL appearing in a Link: or
    ## other header is not recorded in its place.
    link="$(grep -i -o -E -- 'https://web\.archive\.org/web/[^[:space:][:cntrl:]]+' <<<"${location_line}" | head -n1 || true)"
    printf '%s\n' "Archived. Web archive reported that archiving succeeded."
    printf '%s\n' "$1" "${link}" | tee -a -- "${TMPFOLDER}/webarchive/already-archived.txt"
    return 0
  fi

  ## No memento: the status is the save endpoint's own control response.
  case "${curl_http_status_code}" in
    523)
      printf '%s\n' "Origin link down."
      stecho "$1" | tee -a -- "${TMPFOLDER}/webarchive/already-known-down.txt"
      return 0
      ;;
    429)
      printf '%s\n' "Web archive server denied request, reported too many requests. Waiting for ${wait_if_too_many_requests} seconds."
      return 1
      ;;
    520)
      printf '%s\n' "Web archive unknown error."
      stecho "$1" | tee -a -- "${TMPFOLDER}/webarchive/already-known-unknown-error.txt"
      return 0
      ;;
    403)
      printf '%s\n' "Excluded from web archive."
      stecho "$1" | tee -a -- "${TMPFOLDER}/webarchive/already-known-excluded.txt"
      return 0
      ;;
  esac

  printf '%s\n' "Unknown case. curl_http_status_code: ${curl_http_status_code} | curl_output:"
  stecho "${curl_output}"
  stecho "$1" | tee -a -- "${TMPFOLDER}/webarchive/already-unknown-case-error.txt"
  return 0
}

usage() {
  printf '%s\n' "Usage: ${0##*/} FILE
Example:
  ${0##*/} ~/sourcesown/web-links.txt" >&2
  exit 1
}

## Sourced by a test (sourceable skill): the function defs above are all that is wanted,
## so stop here. '(return 0)' succeeds only when sourced; when executed it fails and the
## run continues.
if (return 0 2>/dev/null); then
  return 0
fi

if [[ -z "${1-}" || "${1-}" == "-h" || "${1-}" == "--help" ]]; then
  usage
fi
not_as_root

[[ -v wait_if_too_many_requests ]] || wait_if_too_many_requests=10
[[ -v curl_web_archive_opts ]] || curl_web_archive_opts=(
   "--output" "${TMPFOLDER}/webarchive/curl-output-temp"
   "--silent"
   "--no-progress-meter"
   "--retry-connrefused"
   "--head"
   "--location"
   "-w" "%{http_code}"
)

mkdir --parents -- "${TMPFOLDER}/webarchive"
touch -- "${TMPFOLDER}/webarchive/already-archived.txt"
touch -- "${TMPFOLDER}/webarchive/already-known-down.txt"

log info "See results on '${TMPFOLDER}/webarchive/already-archived.txt' and '${TMPFOLDER}/webarchive/already-known-down.txt'"

file_name="${TMPFOLDER}/wiki-links/links-sorted.txt"
test -r "${file_name}"
total="$(awk -- 'END {print NR}' "${file_name}")"
counter=0

while IFS= read -r word; do
  if [ -z "${word}" ]; then
    continue
  fi
  (( counter++ )) || true
  printf '%s\n' "${counter} / ${total} | word: '${word}'"
  printf '%s\n' "Checking if already archived in locally cached file..."

  do_skip=""
  for cached_file in "${TMPFOLDER}"/webarchive/already-*; do
    if ! [ -f "${cached_file}" ]; then
      continue
    fi
    if grep --fixed-strings -- "${word}" "${cached_file}" >/dev/null 2>&1; then
      printf '%s\n' "Already locally cached file status. cached_file: '${cached_file}'"
      do_skip=true
    fi
  done
  if [ "${do_skip}" = "true" ]; then
    continue
  fi

  for _ in {1..60}; do
    if archive_check "${word}" || archive_save "${word}"; then
      break
    fi
    sleep "${wait_if_too_many_requests}"
  done

  printf '%s\n' ""
done <"${file_name}"
